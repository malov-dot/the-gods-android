<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <meta-data android:name="org.godotengine.plugin.v2.TheGodsUpdater" android:value="games.thegods.updater.TheGodsUpdater" />
        <provider android:name="games.thegods.updater.UpdateFileProvider"
            android:authorities="${applicationId}.thegods.updates"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/the_gods_update_paths" />
        </provider>
    </application>
</manifest>
